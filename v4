  }
  function hueDist(h, peak) { return Math.min(Math.abs(h - peak), 180 - Math.abs(h - peak)); }

  // Hue is circular (0-179, then wraps back to 0) but cv.inRange takes a
  // single non-wrapping [lower, upper] window. Red's true hue sits right at
  // that 0/179 seam, so a peak near either end needs its window split into
  // two pieces and OR'd together -- otherwise real red pixels on the far
  // side of the seam are silently dropped. Green's peak is always mid-range
  // (45-85) so this never changes its mask.
  function buildHueRangeMask(cv, hsvMat, peak, halfWidth) {
    var lo = peak - halfWidth, hi = peak + halfWidth;
    var mask = new cv.Mat();
    function rangeMask(lo2, hi2) {
      var lower = new cv.Mat(hsvMat.rows, hsvMat.cols, hsvMat.type(), [lo2, 60, 40, 0]);
      var upper = new cv.Mat(hsvMat.rows, hsvMat.cols, hsvMat.type(), [hi2, 255, 255, 255]);
      var m = new cv.Mat();
      cv.inRange(hsvMat, lower, upper, m);
