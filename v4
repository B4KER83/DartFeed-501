      for (var c = col; c <= n; c++) M[col][c] /= pivot;
      for (var r2 = 0; r2 < n; r2++) {
        if (r2 === col) continue;
        var factor = M[r2][col];
        if (factor === 0) continue;
        for (var c2 = col; c2 <= n; c2++) M[r2][c2] -= factor * M[col][c2];
      }
    }
    var x = [];
    for (var i2 = 0; i2 < n; i2++) x.push(M[i2][n]);
