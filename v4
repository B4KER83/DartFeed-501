<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#050506">
<title>DartFeed — Play</title>
<style>
  :root {
    color-scheme: dark;
    --bg: #050506; --card: #101113; --card2: #16181b; --line: #25282d;
    --text: #eadcbf; --mut: #8b8f98; --dim: #5a5e66;
    --red: #ff3b2f; --red2: #e0201a; --blue: #2f9bff; --amber: #ffb02e; --ok: #35d07f;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { height: 100%; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: -apple-system, 'SF Pro Display', system-ui, 'Segoe UI', sans-serif; touch-action: manipulation; overflow-x: hidden; }
  .hidden { display: none !important; }
  button { font: inherit; color: inherit; cursor: pointer; }

  .app { max-width: 460px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; padding: 0 14px calc(96px + env(safe-area-inset-bottom)); }

  /* header */
  .top { display: flex; align-items: center; justify-content: space-between; padding: calc(10px + env(safe-area-inset-top)) 2px 10px; }
  .logo { font-size: 27px; font-weight: 800; font-style: italic; letter-spacing: -0.02em; }
  .logo .w2 { color: var(--red); }
  .gear { background: none; border: 1px solid var(--line); border-radius: 12px; width: 40px; height: 40px; display: grid; place-items: center; color: var(--mut); }
  .gear svg { width: 20px; height: 20px; }
  .top { justify-content: flex-end; gap: 8px; }
  .top .logo { margin-right: auto; }
  #btn-sound { color: var(--text); }
  #btn-sound.off { color: var(--dim); }
  #btn-sound:not(.off) .mute, #btn-sound.off .waves { display: none; }

  /* board view */
  .stage { position: relative; width: 100%; height: 42vh; height: 42dvh; min-height: 250px; max-height: 480px; background: #000; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .stage-inner { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transition: left .45s ease, top .45s ease, width .45s ease, height .45s ease; }
  .stage-inner video, .stage-inner img#photo-display { position: absolute; inset: 0; width: 100%; height: 100%; display: block; background: #000; }
  canvas#overlay { position: absolute; top: 0; left: 0; width: 100% !important; height: 100% !important; pointer-events: none; }
  .badge { position: absolute; top: 10px; z-index: 3; display: flex; align-items: center; gap: 7px; background: rgba(0,0,0,.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid rgba(234,220,191,.16); border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700; letter-spacing: .08em; }
  .badge .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dim); }
  #badge-live { left: 10px; }
  #badge-live.on .dot { background: var(--red); box-shadow: 0 0 8px var(--red); animation: blink 1.6s infinite; }
  #badge-ai { right: 10px; }
  #badge-ai.on .dot { background: var(--blue); box-shadow: 0 0 8px var(--blue); }
  #badge-ai.wait .dot { background: var(--amber); animation: blink 1s infinite; }
  @keyframes blink { 50% { opacity: .35; } }
  .chip { position: absolute; left: 50%; bottom: 10px; transform: translateX(-50%); z-index: 3; max-width: calc(100% - 20px); white-space: nowrap; background: rgba(0,0,0,.66); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid rgba(234,220,191,.16); border-radius: 999px; padding: 6px 14px; font-size: 12px; color: var(--text); }
  .chip.tap { border-color: rgba(47,155,255,.55); }
  .zoomctl { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); z-index: 4; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .zoomctl button { width: 38px; height: 38px; border-radius: 12px; background: rgba(0,0,0,.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid rgba(234,220,191,.18); color: var(--text); font-size: 20px; font-weight: 700; line-height: 1; padding: 0; }
  .zoomctl button.fit { font-size: 10px; letter-spacing: .08em; }
  .zoomctl span { font-size: 11px; font-weight: 700; color: var(--text); text-shadow: 0 1px 3px #000; }
  .vidbar { position: absolute; left: 10px; right: 10px; bottom: 10px; z-index: 4; display: flex; align-items: center; gap: 8px; background: rgba(0,0,0,.66); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid rgba(234,220,191,.16); border-radius: 14px; padding: 6px 8px; }
  .vidbar button { min-width: 36px; height: 34px; border-radius: 10px; border: 1px solid var(--line); background: rgba(234,220,191,.05); color: var(--text); font-size: 13px; font-weight: 700; padding: 0 8px; }
  .vidbar button.on { border-color: var(--red); color: var(--red); }
  .vidbar input[type=range] { flex: 1; min-width: 0; accent-color: var(--red2); }
  .vidbar span { font-size: 11px; color: var(--mut); min-width: 34px; text-align: center; font-variant-numeric: tabular-nums; }
  .stage.hasvid .chip { bottom: 60px; }
  .empty { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; background: radial-gradient(circle at 50% 40%, #15181c, #050506 70%); text-align: center; padding: 20px; }
  .empty p { margin: 0 0 4px; color: var(--mut); font-size: 14px; }
  .btn-red { background: var(--red2); border: 0; color: var(--text); font-weight: 700; letter-spacing: .04em; border-radius: 14px; padding: 14px 26px; font-size: 15px; min-width: 190px; }
  .btn-ghost { background: transparent; border: 1px solid var(--line); color: var(--text); border-radius: 14px; padding: 12px 26px; font-size: 14px; min-width: 190px; }

  /* cards */
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; margin-top: 12px; }
  .board { display: grid; grid-template-columns: 1fr 1fr; }
  .player { padding: 14px 8px 12px; text-align: center; position: relative; cursor: pointer; background: none; border: 0; }
  .player + .player { border-left: 1px solid var(--line); }
  .player .nm { font-size: 12px; font-weight: 700; letter-spacing: .12em; color: var(--mut); }
  .player .sc { font-size: 46px; font-weight: 800; line-height: 1.05; margin-top: 2px; color: var(--mut); font-variant-numeric: tabular-nums; }
  .player .avg { font-size: 12px; font-weight: 600; letter-spacing: .06em; color: var(--dim); margin-top: 3px; padding-bottom: 6px; font-variant-numeric: tabular-nums; }
  .player.active .avg { color: var(--mut); }
  .player.active .nm { color: var(--text); }
  .player.active .sc { color: var(--text); }
  .player::after { content: ''; position: absolute; left: 26%; right: 26%; bottom: 0; height: 3px; border-radius: 3px; background: transparent; }
  .player.active::after { background: var(--red); box-shadow: 0 0 10px rgba(255,59,47,.6); }

  .card.turn { position: relative; }
  .flag { position: absolute; top: -11px; right: 16px; z-index: 2; font-size: 11px; font-weight: 800; letter-spacing: .1em; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line); background: #0d0e10; }
  .flag.bust { color: var(--red); border-color: rgba(255,59,47,.5); }
  .flag.win { color: var(--ok); border-color: rgba(53,208,127,.5); }
  .slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 12px; }
  .slot { background: var(--card2); border: 1px solid var(--line); border-radius: 14px; padding: 10px 6px 9px; text-align: center; }
  .slot .k { font-size: 11px; color: var(--mut); letter-spacing: .06em; }
  .slot .v { font-size: 32px; font-weight: 800; line-height: 1.15; color: var(--dim); }
  .slot .p { font-size: 12px; font-weight: 700; letter-spacing: .04em; color: var(--dim); min-height: 16px; }
  .slot.has .v { color: var(--text); }
  .slot.has .p { color: var(--mut); }
  .slot.has.hot .p { color: var(--red); }
  .slot .p .m { color: var(--dim); font-weight: 600; }
  .slot.next { border-color: rgba(255,59,47,.5); }
  .row { display: flex; align-items: center; justify-content: space-between; padding: 13px 16px; border-top: 1px solid var(--line); }
  .row .lbl { display: flex; align-items: center; gap: 9px; font-size: 12px; font-weight: 700; letter-spacing: .12em; color: var(--mut); }
  .row .lbl svg { width: 18px; height: 18px; color: var(--red); }
  .row .val { font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .row .co { font-size: 20px; font-weight: 800; letter-spacing: .01em; }
  .co .r { color: var(--red); } .co span + span { margin-left: .55em; } .co.none { color: var(--dim); }

  /* bottom bar */
  .bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; background: linear-gradient(to top, #050506 70%, rgba(5,5,6,0)); padding: 18px 14px calc(12px + env(safe-area-inset-bottom)); }
  .bar-in { max-width: 460px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .act { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 11px 4px 10px; display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; letter-spacing: .1em; }
  .act svg { width: 24px; height: 24px; color: var(--red); }
  .act:disabled { opacity: .4; }
  .act.attn { border-color: var(--red); box-shadow: 0 0 0 1px var(--red) inset, 0 0 16px rgba(255,59,47,.35); animation: pulse 1.4s infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 1px var(--red) inset, 0 0 4px rgba(255,59,47,.1); } }

  /* sheets */
  .backdrop { position: fixed; inset: 0; z-index: 40; background: rgba(0,0,0,.62); display: flex; align-items: flex-end; justify-content: center; }
  .sheet { width: 100%; max-width: 460px; max-height: 88dvh; overflow-y: auto; background: #0d0e10; border: 1px solid var(--line); border-radius: 22px 22px 0 0; padding: 16px 16px calc(18px + env(safe-area-inset-bottom)); }
  .sheet h2 { margin: 0 0 12px; font-size: 14px; letter-spacing: .12em; color: var(--text); display: flex; justify-content: space-between; align-items: center; }
  .sheet h3 { margin: 18px 0 8px; font-size: 11px; letter-spacing: .14em; color: var(--mut); }
  .x { background: none; border: 1px solid var(--line); border-radius: 10px; width: 36px; height: 36px; color: var(--mut); font-size: 18px; }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-bottom: 10px; }
  .seg button { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 0; font-weight: 700; font-size: 13px; }
  .seg button.on { background: var(--red2); border-color: var(--red2); color: var(--text); }
  .grid5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 6px; }
  .key { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 0; font-size: 18px; font-weight: 700; }
  .key.sm { font-size: 13px; letter-spacing: .06em; }
  .key.rm { color: var(--red); }

  /* settings (engine controls) */
  .controls { display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 0 8px; align-items: center; }
  .controls button, .tool { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 11px 13px; font-size: 13px; min-height: 42px; }
  .controls button.primary { background: #1f4fb8; border-color: #2f62d4; }
  .controls button:disabled { opacity: .4; }
  .controls button.active { background: #2f62d4; }
  .controls label { font-size: 13px; display: flex; align-items: center; gap: 7px; min-height: 40px; }
  input[type=checkbox], input[type=radio] { width: 20px; height: 20px; accent-color: var(--red2); }
  select { background: var(--card); color: var(--text); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: 13px; min-height: 42px; }
  .muted { color: var(--mut); font-size: 12px; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; }
  .pill { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 5px 9px; }
  .pill b { color: #7fd3ff; } .pill.ok b { color: var(--ok); } .pill.bad b { color: #ff6e6e; } .pill.warn b { color: #ffcf7a; }
  .zoom-row { display: flex; align-items: center; gap: 10px; padding: 0 0 8px; font-size: 13px; }
  .zoom-row input[type=range] { flex: 1; height: 32px; }
  .darts-list { font-size: 12px; padding: 4px 0; } .darts-list div { padding: 2px 0; color: #cfe8ff; }
  .mono { font: 12px/1.5 ui-monospace, monospace; background: #0a0b0d; border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; white-space: pre-wrap; overflow-x: auto; margin: 6px 0; }
  #debug-panel .row { display: flex; justify-content: space-between; gap: 10px; border-top: 0; border-bottom: 1px dashed #232a33; padding: 2px 0; }
  #debug-panel .row span:first-child { color: #8a97a6; } #debug-panel .row span:last-child { text-align: right; word-break: break-word; }

  .banner-win { position: fixed; inset: 0; z-index: 50; background: rgba(0,0,0,.8); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 14px; text-align: center; padding: 24px; }
  .banner-win .big { font-size: 38px; font-weight: 800; font-style: italic; }
  .banner-win .big span { color: var(--red); }

  /* LANDSCAPE (phone on its side): board view on the left at full height, everything else stacked on the right */
  @media (orientation: landscape) and (max-height: 600px) {
    .app { max-width: none; width: 100%; height: 100dvh; min-height: 0; overflow: hidden; display: grid; grid-template-columns: 1.1fr 1fr; grid-template-rows: auto auto 1fr auto; column-gap: 12px; align-content: stretch;
           padding: 0 calc(12px + env(safe-area-inset-right)) 0 calc(12px + env(safe-area-inset-left)); }
    .stage { grid-column: 1; grid-row: 1 / 5; height: auto; min-height: 0; max-height: none; margin: calc(8px + env(safe-area-inset-top)) 0 calc(8px + env(safe-area-inset-bottom)); }
    .top { grid-column: 2; grid-row: 1; padding: calc(8px + env(safe-area-inset-top)) 0 4px; }
    .logo { font-size: 22px; }
    .gear { width: 34px; height: 34px; border-radius: 10px; }
    .gear svg { width: 17px; height: 17px; }
    .card { margin-top: 6px; }
    .card.board { grid-column: 2; grid-row: 2; }
    .card.turn { grid-column: 2; grid-row: 3; align-self: start; margin-top: 14px; }
    .player { padding: 8px 6px 4px; }
    .player .sc { font-size: 34px; }
    .player .nm { font-size: 11px; }
    .player .avg { font-size: 11px; margin-top: 1px; padding-bottom: 3px; }
    .slots { padding: 10px 10px 8px; gap: 6px; }
    .slot { padding: 6px 4px 5px; }
    .slot .v { font-size: 26px; }
    .slot .p { font-size: 11px; min-height: 13px; }
    .slot .k { font-size: 10px; }
    .row { padding: 8px 12px; }
    .row .co { font-size: 17px; }
    .bar { position: static; grid-column: 2; grid-row: 4; background: none; padding: 8px 0 calc(8px + env(safe-area-inset-bottom)); }
    .bar-in { max-width: none; gap: 8px; }
    .act { padding: 8px 2px 7px; font-size: 10px; letter-spacing: .03em; white-space: nowrap; flex-direction: row; justify-content: center; gap: 5px; }
    .act svg { width: 20px; height: 20px; }
    .chip { font-size: 11px; padding: 4px 11px; }
    .badge { top: 8px; padding: 4px 10px; font-size: 11px; }
    .sheet { max-height: 94dvh; }
    .key { padding: 8px 0; font-size: 16px; }
    .seg button { padding: 8px 0; }
  }
</style>
</head>
<body>

<div class="app">
  <div class="top">
    <div class="logo"><span class="w1">Dart</span><span class="w2">Feed</span></div>
    <button class="gear" id="btn-sound" aria-label="Score caller on/off">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"/><g class="waves"><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></g><g class="mute"><path d="M22 9l-6 6M16 9l6 6"/></g></svg>
    </button>
    <button class="gear" id="btn-settings" aria-label="Settings">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
    </button>
  </div>

  <!-- BOARD VIEW -->
  <div class="stage" id="stage">
    <div class="badge" id="badge-live"><span class="dot"></span><span id="live-text">OFFLINE</span></div>
    <div class="badge" id="badge-ai"><span class="dot"></span><span>AI DETECTION</span></div>
    <div class="stage-inner" id="stage-inner">
      <video id="video" autoplay playsinline muted></video>
      <img id="photo-display" class="hidden" alt="Loaded photo">
      <canvas id="overlay"></canvas>
    </div>
    <div class="zoomctl" id="zoomctl">
      <button id="zoom-in" aria-label="Zoom in">+</button>
      <span id="zoom-level">1.0×</span>
      <button id="zoom-out" aria-label="Zoom out">−</button>
      <button id="zoom-fit" aria-label="Reset zoom" class="fit">1×</button>
    </div>
    <div class="vidbar hidden" id="vidbar">
      <button id="vid-play" aria-label="Play or pause">&#10074;&#10074;</button>
      <input type="range" id="vid-seek" min="0" max="1000" value="0" aria-label="Seek">
      <span id="vid-time">0:00</span>
      <button id="vid-speed" aria-label="Playback speed">1&times;</button>
      <button id="vid-loop" aria-label="Loop">&#8635;</button>
    </div>
    <div class="chip hidden" id="chip"></div>
    <div class="empty" id="empty">
      <p>Point the phone at the board, or try a photo.</p>
      <button class="btn-red" id="go-camera">START CAMERA</button>
      <button class="btn-ghost" id="go-photo">LOAD PHOTO</button>
      <button class="btn-ghost" id="go-video">LOAD VIDEO</button>
    </div>
  </div>

  <!-- SCOREBOARD -->
  <div class="card board">
    <button class="player active" id="pl0"><div class="nm" id="nm0">PLAYER 1</div><div class="sc" id="sc0">501</div><div class="avg" id="avg0">Avg —</div></button>
    <button class="player" id="pl1"><div class="nm" id="nm1">PLAYER 2</div><div class="sc" id="sc1">501</div><div class="avg" id="avg1">Avg —</div></button>
  </div>

  <!-- CURRENT TURN -->
  <div class="card turn">
    <div class="flag hidden" id="flag"></div>
    <div class="slots">
      <button class="slot" id="slot0"><div class="k">Dart 1</div><div class="v">—</div><div class="p"></div></button>
      <button class="slot" id="slot1"><div class="k">Dart 2</div><div class="v">—</div><div class="p"></div></button>
      <button class="slot" id="slot2"><div class="k">Dart 3</div><div class="v">—</div><div class="p"></div></button>
    </div>
    <div class="row">
      <div class="lbl">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 4 14h6l-1 8 9-12h-6z"/></svg>
        <span id="co-label">SUGGESTED CHECKOUT</span>
      </div>
      <div class="co none" id="checkout">—</div>
    </div>
  </div>

<!-- ACTION BAR (inside .app so landscape can place it in the right-hand column; fixed to the bottom in portrait) -->
<div class="bar"><div class="bar-in">
  <button class="act" id="btn-undo">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg>UNDO
  </button>
  <button class="act" id="btn-manual">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11V5a2 2 0 1 1 4 0v5"/><path d="M13 10V8a2 2 0 1 1 4 0v4"/><path d="M17 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-1a7 7 0 0 1-5.6-2.8L3 15.5a2 2 0 0 1 3-2.6L9 16V11"/></svg>MANUAL
  </button>
  <button class="act" id="btn-next">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M17 8h5m-2-2.5L22 8l-2 2.5"/></svg>NEXT PLAYER
  </button>
</div></div>
</div>

<!-- MANUAL ENTRY -->
<div class="backdrop hidden" id="manual-backdrop"><div class="sheet" id="manual-sheet">
  <h2><span id="manual-title">ADD DART</span><button class="x" id="manual-close">✕</button></h2>
