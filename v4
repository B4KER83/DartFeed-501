<script>

(function () {
  'use strict';

  function $(id) { return document.getElementById(id); }

  // =========================================================================
  // 0. DETECTOR CONTRACT
  // A dart detection is always: { x, y, confidence, type: 'dart-tip' }.
  // Board geometry / calibration / homography / scoring below never know or
  // care which model produced it -- they only ever read x/y/confidence/type.
  // This page wires in exactly ONE detector (DartFeedTipModelAdapter,
  // below); no other detector and no fallback path exists.
  // =========================================================================

  // =========================================================================
  // 1. DARTFEED TIP MODEL (DartTipHeatmapNet, homegrown, trained from
  // scratch by this project -- NOT a third-party model, no licence
  // restriction on distributing it). Ported verbatim from the local test
  // bench's own adapter; only the weight-loading path changed, from an
  // embedded base64 blob to a relative-path fetch so this page can be
  // served as plain static files from GitHub Pages.
  //   Architecture: DartTipHeatmapNet -- 177,745 parameters, single-channel
  //     heatmap output.
  //   Input: 320x416 RGB, DIRECT resize (stretched, not letterboxed),
  //     scaled to [0,1] then ImageNet-normalised.
  //   Output: (1,1,104,80) heatmap logits (sigmoid applied here).
  //   Decode: greedy local-maxima extraction, NMS radius 4, capped at 3
  //     tips, confidence threshold 0.7 (see this project's own
  //     V0.4_MULTI_DART.md threshold sweep for why 0.7 was chosen).
  // =========================================================================
  var DartFeedTipModelAdapter = (function () {
    var INPUT_W = 320, INPUT_H = 416;
    var OUTPUT_STRIDE = 4;
    var HEATMAP_H = 104, HEATMAP_W = 80;
    var NMS_RADIUS = 4;
    // Minimum peak confidence for a detection. v0.4's own threshold sweep chose 0.7,
    // but phantom detections on a bare board sit just above 0.7 (measured: 3-4
    // phantoms in 16 empty-board photos at 0.70, none at 0.75) while real darts
    // mostly score higher, so the default here is 0.75. Adjustable on the page.
    var DEFAULT_CONFIDENCE_THRESHOLD = 0.75;
    var confidenceThreshold = DEFAULT_CONFIDENCE_THRESHOLD;
    var MAX_DARTS = 3;
    var MEAN = [0.485, 0.456, 0.406], STD = [0.229, 0.224, 0.225];
    // Relative to this HTML file's own location -- works unmodified from
    // GitHub Pages, a plain local static-file server, or file:// (Chrome;
    // iOS Safari requires https:// or localhost for camera access
    // regardless of this path).
    // MODEL REGISTRY -- both entries are the SAME network (DartTipHeatmapNet,
    // identical input/output tensors, preprocessing, decode and thresholds);
    // only the weights differ. The Synthetic 600 model is the default; the
    // original v0.4 stays available in the selector and is the automatic
    // fallback if the default cannot be loaded. Each entry carries a version +
    // expected SHA-256 so a stale browser/CDN cache can never silently serve the
    // wrong weights: model URLs are cache-busted with ?v=<hash prefix> where
    // versioned, fetched with cache:'no-store', and hash-checked before use.
    var MODELS = {
      original: {
        label: 'Original v0.4', adapterName: 'DartFeed Tip v0.4', version: 'v0.4-original',
        url: './models/v0.4_best.onnx',
        sha256: '3f40407bef9ded0e32e245c4b5a3edaf6f417a0e4e906c3a2de35b0023641937'
      },
      syn600: {
        label: 'Synthetic 600 seed 22', adapterName: 'DartFeed Tip (v0.4 recipe, +600 synthetic, seed 22)', version: 'syn600-seed22-v1',
        url: './models/dartfeed_syn600_seed22.onnx?v=a4d91face26f',
        sha256: 'a4d91face26ff57f3322ef42428d037e3e3b01efbf7ff3863cae2fe1b373b2f4'
      }
    };
    var DEFAULT_MODEL_KEY = 'syn600';
    var FALLBACK_MODEL_KEY = 'original';
    var loadNote = '';
    var sessions = {};
    var activeKey = DEFAULT_MODEL_KEY;

    var session = null;
    var preCanvas = null, preCtx = null;
    var ortLoadPromise = null;
    var ORT_URL = 'https://cdn.jsdelivr.net/npm/onnxruntime-web@1.19.2/dist/ort.min.js';

    function ensureOrt() {
      if (window.ort) return Promise.resolve();
      if (ortLoadPromise) return ortLoadPromise;
      ortLoadPromise = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = ORT_URL;
        s.onload = resolve;
        s.onerror = function () { reject(new Error('Could not load onnxruntime-web from CDN.')); };
        document.head.appendChild(s);
      });
      return ortLoadPromise;
    }

    // Boot load: the default model through the same hash-checked path as every
    // switch; if that fails (missing/stale/corrupt file) fall back to the
    // original so the page still works, and say so.
    function load() {
      return setActiveModel(DEFAULT_MODEL_KEY).catch(function (err) {
        if (DEFAULT_MODEL_KEY === FALLBACK_MODEL_KEY) throw err;
        console.error('Default model failed to load, falling back:', err);
        loadNote = 'could not load ' + MODELS[DEFAULT_MODEL_KEY].label + ' (' + err.message + ') — using ' + MODELS[FALLBACK_MODEL_KEY].label;
        return setActiveModel(FALLBACK_MODEL_KEY);
      });
    }

    function hex(buf) {
      var b = new Uint8Array(buf), s = '';
      for (var i = 0; i < b.length; i++) s += (b[i] < 16 ? '0' : '') + b[i].toString(16);
      return s;
    }

    // Loads (once) and caches the session for a registry entry. Used for model
    // switching only; the default model's boot path in load() is unchanged.
    function loadModel(key) {
      var info = MODELS[key];
      if (!info) return Promise.reject(new Error('Unknown model: ' + key));
      if (sessions[key]) return Promise.resolve(sessions[key]);
      return ensureOrt().then(function () {
        window.ort.env.wasm.numThreads = 1;
        return fetch(info.url, { cache: 'no-store' });
      }).then(function (resp) {
        if (!resp.ok) throw new Error('HTTP ' + resp.status + ' fetching ' + info.url);
        return resp.arrayBuffer();
      }).then(function (buf) {
        var verify = (window.crypto && window.crypto.subtle)
          ? window.crypto.subtle.digest('SHA-256', buf).then(function (d) {
              var h = hex(d);
              if (h !== info.sha256) throw new Error('model file does not match expected version ' + info.version + ' (got sha256 ' + h.slice(0, 12) + ', expected ' + info.sha256.slice(0, 12) + ') -- stale or wrong file');
            })
          : Promise.resolve();   // non-secure context: no SubtleCrypto, rely on the cache-busted URL + no-store
        return verify.then(function () {
          return window.ort.InferenceSession.create(new Uint8Array(buf), { executionProviders: ['wasm'] });
        });
      }).then(function (sess) {
        sessions[key] = sess;
        return sess;
      });
    }

    function setActiveModel(key) {
      return loadModel(key).then(function (sess) {
        session = sess;
        activeKey = key;
      });
    }

    function getActiveModel() {
      var m = MODELS[activeKey];
      return { key: activeKey, label: m.label, version: m.version, sha256: m.sha256, url: m.url };
    }

    function isReady() { return !!session; }

    // ---- ANTIALIASED DOWNSCALE to 320x416 --------------------------------
    // The model was trained on PIL's img.resize((320,416), BILINEAR), which for a
    // big reduction is an ANTIALIASED triangle filter. A single canvas drawImage
    // from a full-resolution camera frame is not (it just skips pixels), and the
    // aliasing it creates on the board's wires/sisal produces extra spurious
    // detections. So: halve with the canvas while the result stays >= 2x the
    // target (an exact 2x2 average), then apply the exact separable triangle
    // filter PIL uses for the last step. Measured against exact PIL-style
    // resizing on 58 real photos: same detections within noise, ~tens of ms.
    var scratchCanvases = [];
    var weightCache = {};
    var bufFloatA = null, bufFloatB = null;
    function scratch(i, w, h) {
      var c = scratchCanvases[i];
      if (!c) c = scratchCanvases[i] = document.createElement('canvas');
      if (c.width !== w || c.height !== h) { c.width = w; c.height = h; }
      return c;
    }
    function axisWeights(srcLen, dstLen) {
      var key = srcLen + '>' + dstLen;
      if (weightCache[key]) return weightCache[key];
      var scale = srcLen / dstLen, support = Math.max(1, scale), table = [];
      for (var i = 0; i < dstLen; i++) {
        var c = (i + 0.5) * scale;
        var lo = Math.max(0, Math.floor(c - support + 0.5)), hi = Math.min(srcLen, Math.floor(c + support + 0.5));
        var w = [], s = 0;
        for (var k = lo; k < hi; k++) { var v = Math.max(0, 1 - Math.abs((k + 0.5 - c) / support)); w.push(v); s += v; }
        for (var j = 0; j < w.length; j++) w[j] /= s;
        table.push({ lo: lo, w: Float32Array.from(w) });
      }
      weightCache[key] = table;
      return table;
    }
    function downscaleToInput(source, sw, sh) {
      var src = source, step = 0;
      while (sw / 2 >= 2 * INPUT_W && sh / 2 >= 2 * INPUT_H) {
        var nw = Math.floor(sw / 2), nh = Math.floor(sh / 2);
        var c = scratch(step++ % 2, nw, nh), cx = c.getContext('2d');
        cx.imageSmoothingEnabled = true; cx.imageSmoothingQuality = 'high';
        cx.drawImage(src, 0, 0, sw, sh, 0, 0, nw, nh);
        src = c; sw = nw; sh = nh;
      }
      var rc = scratch(2, sw, sh), rx = rc.getContext('2d', { willReadFrequently: true });
      rx.drawImage(src, 0, 0, sw, sh);
      var px = rx.getImageData(0, 0, sw, sh).data;
      var n = sw * sh * 3;
      if (!bufFloatA || bufFloatA.length < n) bufFloatA = new Float32Array(n);
      var hzLen = INPUT_W * sh * 3;
      if (!bufFloatB || bufFloatB.length < hzLen) bufFloatB = new Float32Array(hzLen);
      for (var i = 0, j = 0; i < sw * sh; i++, j += 3) { bufFloatA[j] = px[i * 4]; bufFloatA[j + 1] = px[i * 4 + 1]; bufFloatA[j + 2] = px[i * 4 + 2]; }
      var wx = axisWeights(sw, INPUT_W), wy = axisWeights(sh, INPUT_H);
      var y, x, k, o, p, r, g, b, t;
      for (y = 0; y < sh; y++) {                       // horizontal pass
        for (x = 0; x < INPUT_W; x++) {
          t = wx[x]; r = g = b = 0;
          for (k = 0; k < t.w.length; k++) { p = (y * sw + t.lo + k) * 3; r += t.w[k] * bufFloatA[p]; g += t.w[k] * bufFloatA[p + 1]; b += t.w[k] * bufFloatA[p + 2]; }
          o = (y * INPUT_W + x) * 3; bufFloatB[o] = r; bufFloatB[o + 1] = g; bufFloatB[o + 2] = b;
        }
      }
      var out = new Uint8ClampedArray(INPUT_W * INPUT_H * 4);
      for (y = 0; y < INPUT_H; y++) {                  // vertical pass
        t = wy[y];
        for (x = 0; x < INPUT_W; x++) {
          r = g = b = 0;
          for (k = 0; k < t.w.length; k++) { p = ((t.lo + k) * INPUT_W + x) * 3; r += t.w[k] * bufFloatB[p]; g += t.w[k] * bufFloatB[p + 1]; b += t.w[k] * bufFloatB[p + 2]; }
          o = (y * INPUT_W + x) * 4; out[o] = Math.round(r); out[o + 1] = Math.round(g); out[o + 2] = Math.round(b); out[o + 3] = 255;
        }
      }
      return out;
    }

    // Direct (non-aspect-preserving) resize to 320x416 -- matches
    // dataset.py's img.resize((320,416)) in geometry (stretched, not letterboxed)
    // AND now in filtering (antialiased), see downscaleToInput above.
    function preprocess(source, sourceW, sourceH) {
      var imgData = downscaleToInput(source, sourceW, sourceH);
      var chw = new Float32Array(3 * INPUT_W * INPUT_H);
      var plane = INPUT_W * INPUT_H;
      for (var y = 0; y < INPUT_H; y++) {
        for (var x = 0; x < INPUT_W; x++) {
          var pIdx = (y * INPUT_W + x) * 4;
          var oIdx = y * INPUT_W + x;
          chw[oIdx] = (imgData[pIdx] / 255 - MEAN[0]) / STD[0];
          chw[plane + oIdx] = (imgData[pIdx + 1] / 255 - MEAN[1]) / STD[1];
          chw[2 * plane + oIdx] = (imgData[pIdx + 2] / 255 - MEAN[2]) / STD[2];
        }
      }
      return chw;
    }

    function sigmoid(v) { return 1 / (1 + Math.exp(-v)); }

    // Exact port of decode_multi.py's heatmap_to_tips(): greedy global-max
    // extraction with a suppression radius so one blob's own shoulder isn't
    // double-counted, capped at MAX_DARTS. Deliberately a manual scan, NOT
    // heatmapData.map()/.sort() -- heatmapData is a Float32Array, and
    // TypedArray.prototype.map() silently coerces a returned {i,v} object to
    // NaN instead of storing it, which breaks the confidence check outright
    // (confirmed by direct testing: every decoded tip came back NaN/
    // undefined even though the confidence gate should have rejected them).
    function decodeHeatmap(raw) {
      var n = HEATMAP_H * HEATMAP_W;
      var sig = new Float32Array(n);
      for (var i = 0; i < n; i++) sig[i] = sigmoid(raw[i]);
      var tips = [];
      for (var k = 0; k < MAX_DARTS; k++) {
        var bestIdx = -1, bestVal = -Infinity;
        for (var j = 0; j < n; j++) {
          if (sig[j] > bestVal) { bestVal = sig[j]; bestIdx = j; }
        }
        if (bestVal < confidenceThreshold) break;
        var by = Math.floor(bestIdx / HEATMAP_W), bx = bestIdx % HEATMAP_W;
        tips.push({ x: bx, y: by, confidence: bestVal });
        var y0 = Math.max(0, by - NMS_RADIUS), y1 = Math.min(HEATMAP_H, by + NMS_RADIUS + 1);
        var x0 = Math.max(0, bx - NMS_RADIUS), x1 = Math.min(HEATMAP_W, bx + NMS_RADIUS + 1);
        for (var yy = y0; yy < y1; yy++) {
          for (var xx = x0; xx < x1; xx++) sig[yy * HEATMAP_W + xx] = -1;
        }
      }
      return tips;
    }

    function predict(frame) {
      if (!session) return Promise.reject(new Error('DartFeed model not loaded yet'));
      var chw = preprocess(frame.canvas, frame.width, frame.height);
      var tensor = new window.ort.Tensor('float32', chw, [1, 3, INPUT_H, INPUT_W]);
      var runSession = session;
      return runSession.run({ input: tensor }).then(function (results) {
        // If the user switched models while this frame was in flight, drop the
        // result rather than show the previous model's output as the new one's.
        if (runSession !== session) return [];
        var outKey = Object.keys(results)[0];
        var out = results[outKey];
        var tips = decodeHeatmap(out.data);
        var scaleX = INPUT_W / frame.width, scaleY = INPUT_H / frame.height;
        return tips.map(function (t) {
          var xInput = t.x * OUTPUT_STRIDE, yInput = t.y * OUTPUT_STRIDE;
          return {
            x: xInput / scaleX, y: yInput / scaleY,
            confidence: t.confidence, type: 'dart-tip'
          };
        });
      });
    }

    function dispose() { session = null; }

    return {
      // Reflects the active model; the default (original) keeps the exact
      // string it always had, so debug panel + export JSON read correctly.
      get name() { return MODELS[activeKey].adapterName; },
      load: load, isReady: isReady, predict: predict, dispose: dispose,
      models: MODELS, getActiveModel: getActiveModel, setActiveModel: setActiveModel, getLoadNote: function () { return loadNote; },
      inputWidth: INPUT_W, inputHeight: INPUT_H,
      get confidenceThreshold() { return confidenceThreshold; },
      setConfidenceThreshold: function (v) { confidenceThreshold = v; },
      iouThreshold: null
    };
  })();

  var activeAdapter = DartFeedTipModelAdapter;

  // =========================================================================
  // 2. BOARD GEOMETRY -- ported verbatim from the local test bench (which
  // itself ports DartFeed's own production detector): find the double
  // ring's red/green hue peaks adaptively -> mask + contour + ellipse-fit
  // -> walk 720 points around its boundary looking for red<->green
  // transitions (~20 on a real board).
  // =========================================================================
  var OpenCVLoader = (function () {
    var loadingPromise = null;
    var CDN_URLS = [
      'https://cdn.jsdelivr.net/npm/@techstark/opencv-js/dist/opencv.js',
      'https://docs.opencv.org/4.9.0/opencv.js'
    ];
    function waitForRuntime(resolve, reject) {
      var checks = 0;
      var poll = setInterval(function () {
        checks++;
        if (window.cv && typeof window.cv.Mat === 'function') { clearInterval(poll); resolve(); return; }
        if (checks > 300) { clearInterval(poll); reject(new Error('OpenCV runtime did not finish initialising in time.')); }
      }, 100);
    }
    function loadFrom(url) {
      return new Promise(function (resolve, reject) {
        var script = document.createElement('script');
        script.src = url; script.async = true;
        script.onload = function () {
          if (window.cv && typeof window.cv.then === 'function') { window.cv.then(function (resolved) { window.cv = resolved; resolve(); }).catch(reject); return; }
          if (window.cv && typeof window.cv.Mat === 'function') { resolve(); return; }
          if (window.cv) { window.cv['onRuntimeInitialized'] = resolve; }
          waitForRuntime(resolve, reject);
        };
        script.onerror = function () { reject(new Error('Could not load ' + url)); };
        document.head.appendChild(script);
      });
    }
    function load() {
      if (loadingPromise) return loadingPromise;
      loadingPromise = loadFrom(CDN_URLS[0]).catch(function () { return loadFrom(CDN_URLS[1]); });
      return loadingPromise;
    }
    function isReady() { return !!(window.cv && typeof window.cv.Mat === 'function'); }
    return { load: load, isReady: isReady };
  })();

  function findAdaptiveHuePeaks(hsvMat) {
    var data = hsvMat.data, n = hsvMat.rows * hsvMat.cols;
    var hueHist = new Array(180).fill(0);
    for (var i = 0; i < n; i++) {
      var h = data[i * 3], s = data[i * 3 + 1], v = data[i * 3 + 2];
      if (s > 80 && v > 60) hueHist[h]++;
    }
    var greenPeak = 45, greenMax = -1;
    for (var g = 45; g < 85; g++) { if (hueHist[g] > greenMax) { greenMax = hueHist[g]; greenPeak = g; } }
    var lowRedPeak = 0, lowRedMax = -1;
    for (var r1 = 0; r1 < 15; r1++) { if (hueHist[r1] > lowRedMax) { lowRedMax = hueHist[r1]; lowRedPeak = r1; } }
    var highRedPeak = 165, highRedMax = -1;
    for (var r2 = 165; r2 < 180; r2++) { if (hueHist[r2] > highRedMax) { highRedMax = hueHist[r2]; highRedPeak = r2; } }
    var redPeak = lowRedMax > highRedMax ? lowRedPeak : highRedPeak;
