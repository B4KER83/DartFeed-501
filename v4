    var topmostIdx = 0;
    for (var k = 1; k < n; k++) if (withAngle[k].y < withAngle[topmostIdx].y) topmostIdx = k;
    var prevIdx = (topmostIdx - 1 + n) % n, nextIdx = (topmostIdx + 1) % n;
    var twentyWedgeStartIdx = (withAngle[prevIdx].y < withAngle[nextIdx].y) ? prevIdx : topmostIdx;

    var offset = 0;
    withAngle[twentyWedgeStartIdx].offset = 0;
    var idx = twentyWedgeStartIdx;
    for (var step = 1; step < n; step++) {
      var nextI = (idx + 1) % n;
      var gapDeg = ((withAngle[nextI].angle - withAngle[idx].angle) * 180 / Math.PI + 3600) % 360;
      var increment = gapDeg <= RING_SPACING_MAX_DEG ? 1 : Math.round(gapDeg / 18);
      offset += Math.max(1, increment);
      withAngle[nextI].offset = offset;
      idx = nextI;
    }
    for (var j = 0; j < n; j++) {
      var off = withAngle[j].offset % 20;
      withAngle[j].segmentClockwise = SCORE_SEGMENT_ORDER[off];
      withAngle[j].segmentAnticlockwise = SCORE_SEGMENT_ORDER[(off - 1 + 20) % 20];
      withAngle[j].boardAngle = (off * 18) * Math.PI / 180;
    }
    return withAngle;
  }

  function chooseFourCorners(labelledPoints) {
    var targets = [45, 135, 225, 315].map(function (d) { return d * Math.PI / 180; });
    var chosen = targets.map(function (target) {
      var best = null, bestDiff = Infinity;
      labelledPoints.forEach(function (p) {
        var diff = Math.abs(p.boardAngle - target);
        diff = Math.min(diff, Math.PI * 2 - diff);
        if (diff < bestDiff) { bestDiff = diff; best = p; }
      });
      return best;
    });
    if (chosen.some(function (c) { return !c; })) return null;
    var top = chosen.slice().sort(function (a, b) { return a.y - b.y; });
    var bottom = chosen.slice().sort(function (a, b) { return b.y - a.y; });
    var ordered = [top[0], bottom[0], bottom[1], top[1]];
    if (ordered[0].x > ordered[3].x) { var t = ordered[0]; ordered[0] = ordered[3]; ordered[3] = t; }
    if (ordered[1].x > ordered[2].x) { var t2 = ordered[1]; ordered[1] = ordered[2]; ordered[2] = t2; }
    return ordered;
  }

  function solveLinearSystem(A, b) {
    var n = b.length;
    var M = A.map(function (row, i) { return row.concat([b[i]]); });
    for (var col = 0; col < n; col++) {
      var maxRow = col, maxVal = Math.abs(M[col][col]);
      for (var r = col + 1; r < n; r++) { if (Math.abs(M[r][col]) > maxVal) { maxVal = Math.abs(M[r][col]); maxRow = r; } }
      if (maxVal < 1e-9) return null;
      if (maxRow !== col) { var tmp = M[col]; M[col] = M[maxRow]; M[maxRow] = tmp; }
