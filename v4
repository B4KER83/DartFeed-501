      return m;
    }
    if (lo < 0) {
      var maskA1 = rangeMask(0, Math.min(179, hi));
      var maskA2 = rangeMask(Math.max(0, 180 + lo), 179);
      cv.bitwise_or(maskA1, maskA2, mask);
      maskA1.delete(); maskA2.delete();
    } else if (hi > 179) {
      var maskB1 = rangeMask(Math.max(0, lo), 179);
      var maskB2 = rangeMask(0, Math.min(179, hi - 180));
      cv.bitwise_or(maskB1, maskB2, mask);
      maskB1.delete(); maskB2.delete();
    } else {
      var m = rangeMask(lo, hi);
      m.copyTo(mask);
      m.delete();
    }
    return mask;
  }

  function findRingEllipse(cv, hsvMat, peaks, frameW, frameH) {
    var maskRed = buildHueRangeMask(cv, hsvMat, peaks.red, 14);
    var maskGreen = buildHueRangeMask(cv, hsvMat, peaks.green, 14);
    var maskCombined = new cv.Mat();
    cv.bitwise_or(maskRed, maskGreen, maskCombined);

    var kernel = cv.Mat.ones(8, 8, cv.CV_8U);
    var closed = new cv.Mat();
    cv.morphologyEx(maskCombined, closed, cv.MORPH_CLOSE, kernel);

    var contours = new cv.MatVector();
    var hierarchy = new cv.Mat();
    cv.findContours(closed, contours, hierarchy, cv.RETR_EXTERNAL, cv.CHAIN_APPROX_NONE);

    var minAreaThreshold = (frameW * frameH) * 0.02;
    var candidates = [];
    for (var i = 0; i < contours.size(); i++) {
      var cnt = contours.get(i);
      var area = cv.contourArea(cnt);
      if (area > minAreaThreshold && cnt.rows >= 30) {
        var rect = cv.fitEllipse(cnt);
        var w = rect.size.width, h = rect.size.height;
        if (isFinite(w) && isFinite(h) && w > 0 && h > 0) {
          var a, b, angleRad;
          if (w >= h) { a = w / 2; b = h / 2; angleRad = rect.angle * Math.PI / 180; }
          else { a = h / 2; b = w / 2; angleRad = rect.angle * Math.PI / 180 + Math.PI / 2; }
          candidates.push({ cx: rect.center.x, cy: rect.center.y, a: a, b: b, angleRad: angleRad, area: area, meanR: (a + b) / 2 });
        }
      }
      cnt.delete();
    }

    var result = null;
    if (candidates.length === 1) {
      result = candidates[0];
    } else if (candidates.length > 1) {
      var xs = candidates.map(function (c) { return c.cx; }).sort(function (p, q) { return p - q; });
      var ys = candidates.map(function (c) { return c.cy; }).sort(function (p, q) { return p - q; });
      var medianCx = xs[Math.floor(xs.length / 2)], medianCy = ys[Math.floor(ys.length / 2)];
      var maxR = candidates.reduce(function (m, c) { return Math.max(m, c.meanR); }, 0);
      var CONCENTRIC_TOLERANCE = 0.35;
      var concentricGroup = candidates.filter(function (c) { return Math.hypot(c.cx - medianCx, c.cy - medianCy) < maxR * CONCENTRIC_TOLERANCE; });
      var pool = concentricGroup.length ? concentricGroup : candidates;
      result = pool.reduce(function (a, b) { return b.meanR > a.meanR ? b : a; });
    }

    [maskRed, maskGreen, maskCombined, kernel, closed, hierarchy].forEach(function (m) { m.delete(); });
    contours.delete();
    return result;
  }

  // Sampled slightly inside the fitted ellipse's own edge (not at 1.0) to
  // avoid the noisy anti-aliased/wire pixels right at the mask boundary.
  // Shared by walkRingForPoints() (20-point path) and the 4-point landmark
  // search below.
  var RING_WALK_RFRAC = 0.97;

  function buildRingWalkLabels(cv, hsvMat, ring, peaks, frameW, frameH) {
    var n = 720, rFrac = RING_WALK_RFRAC;
    var cos = Math.cos(ring.angleRad), sin = Math.sin(ring.angleRad);
    var data = hsvMat.data;
    var labels = [], coords = [];
    for (var i = 0; i < n; i++) {
      var theta = (i / n) * Math.PI * 2;
      var lx = ring.a * rFrac * Math.cos(theta), ly = ring.b * rFrac * Math.sin(theta);
      var px = ring.cx + lx * cos - ly * sin;
      var py = ring.cy + lx * sin + ly * cos;
      coords.push({ x: px, y: py });
      var ipx = Math.round(px), ipy = Math.round(py);
      if (ipx >= 0 && ipx < frameW && ipy >= 0 && ipy < frameH) {
        var idx = ipy * frameW + ipx;
        var h = data[idx * 3], s = data[idx * 3 + 1], v = data[idx * 3 + 2];
        if (s > 60 && v > 40) {
          if (hueDist(h, peaks.red) <= 14) labels.push('R');
          else if (hueDist(h, peaks.green) <= 14) labels.push('G');
          else labels.push(null);
        } else labels.push(null);
      } else labels.push(null);
    }
    var filled = [], last = null;
    for (var j = 0; j < n; j++) { if (labels[j]) last = labels[j]; filled.push(last); }
    // rawLabels (pre-fill) is carried alongside filled purely for the HUE
    // DIAG diagnostic overlay below -- nothing in the calibration/scoring
    // path reads it, so adding it here cannot change any existing behaviour.
    return { n: n, coords: coords, filled: filled, rawLabels: labels };
  }

  function walkRingForPoints(cv, hsvMat, ring, peaks, frameW, frameH) {
    var walk = buildRingWalkLabels(cv, hsvMat, ring, peaks, frameW, frameH);
    var n = walk.n, coords = walk.coords, filled = walk.filled;
    var coverage = filled.filter(function (l) { return l; }).length / n;
    var transitionPoints = [];
    for (var k = 0; k < n; k++) {
      if (filled[(k - 1 + n) % n] && filled[k] && filled[(k - 1 + n) % n] !== filled[k]) transitionPoints.push(coords[k]);
    }
    return {
      points: transitionPoints, coverage: coverage, ring: ring,
      diag: { coords: coords, rawLabels: walk.rawLabels }
    };
  }

  // =========================================================================
  // 3. 4-POINT (AutoDarts-style) CALIBRATION -- ported verbatim. The four
  // landmarks are the physical boundaries BETWEEN these segment pairs (not
  // segment centres), spaced 90 degrees apart: 1/20, 6/10, 3/19, 11/14.
  // Their board angles are read off SCORE_SEGMENT_ORDER (declared below),
  // never hand-typed.
  // =========================================================================
  function boundaryAngleDegBefore(segmentNumber) {
    var k = SCORE_SEGMENT_ORDER.indexOf(segmentNumber);
    if (k === -1) throw new Error('Unknown segment number ' + segmentNumber);
    return k * 18;
  }
  var _fourPointLandmarksCache = null;
  function getFourPointLandmarks() {
    if (!_fourPointLandmarksCache) {
      _fourPointLandmarksCache = [
        { name: '1/20', boardAngleDeg: boundaryAngleDegBefore(1) },
        { name: '6/10', boardAngleDeg: boundaryAngleDegBefore(10) },
        { name: '3/19', boardAngleDeg: boundaryAngleDegBefore(19) },
        { name: '11/14', boardAngleDeg: boundaryAngleDegBefore(14) }
      ];
    }
    return _fourPointLandmarksCache;
  }
  var FOUR_POINT_SEARCH_WINDOW_DEG = 12;
  var FOUR_POINT_MAX_SAFE_GAP_DEG = 45;

  function circularMeanRad(angles) {
    var sx = 0, sy = 0;
    angles.forEach(function (a) { sx += Math.cos(a); sy += Math.sin(a); });
    return Math.atan2(sy, sx);
  }

  // Known landmark -> known board angle -> expected image location (via a
  // reference orientation established the SAME way the 20-point path does,
  // labelRingPoints()'s topmost-point heuristic) -> local search around
  // that expected location -> strongest nearby colour transition. Fully
  // dynamic: every input (ring.cx/cy/a/b/angleRad, the reference angle) is
  // recomputed fresh from THIS image's own detected geometry -- no fixed
  // pixel coordinates anywhere.
  function detectFourPointLandmarks(cv, hsvMat, ring, peaks, frameW, frameH) {
    var walk = buildRingWalkLabels(cv, hsvMat, ring, peaks, frameW, frameH);
    var n = walk.n, coords = walk.coords, filled = walk.filled;

    var rawTransitions = [];
    for (var k = 0; k < n; k++) {
      if (filled[(k - 1 + n) % n] && filled[k] && filled[(k - 1 + n) % n] !== filled[k]) rawTransitions.push(coords[k]);
    }
    var mergedForLandmarks = mergeCloseRingPoints(rawTransitions, { x: ring.cx, y: ring.cy }, RING_SPACING_MIN_DEG);
    var globalTransitions = mergedForLandmarks.points;
    if (globalTransitions.length < 3) {
      return {
        referenceAngle: null,
        landmarks: getFourPointLandmarks().map(function (lm) {
          return { name: lm.name, boardAngleDeg: lm.boardAngleDeg, found: false, reason: 'Not enough ring structure detected anywhere to establish board orientation.' };
        })
      };
    }
    var sortedByAngle = globalTransitions.map(function (p) {
      return { x: p.x, y: p.y, angle: Math.atan2(p.y - ring.cy, p.x - ring.cx) };
    }).sort(function (a, b) { return a.angle - b.angle; });
    var maxGapDeg = 0;
    for (var g = 0; g < sortedByAngle.length; g++) {
      var next = sortedByAngle[(g + 1) % sortedByAngle.length];
      var gapDeg = ((next.angle - sortedByAngle[g].angle + Math.PI * 2 * 3) % (Math.PI * 2)) * 180 / Math.PI;
      maxGapDeg = Math.max(maxGapDeg, gapDeg);
    }
    if (maxGapDeg > FOUR_POINT_MAX_SAFE_GAP_DEG) {
      var gapReason = 'Board orientation unreliable -- a ' + maxGapDeg.toFixed(1) + ' degree gap in the detected ring (several boundaries missing at once) is too large to safely reconstruct which segments were skipped.';
      return {
        referenceAngle: null,
        landmarks: getFourPointLandmarks().map(function (lm) {
          return { name: lm.name, boardAngleDeg: lm.boardAngleDeg, found: false, reason: gapReason };
        })
      };
    }
    var labelled = labelRingPoints(globalTransitions, { x: ring.cx, y: ring.cy });
    var refAngle = circularMeanRad(labelled.map(function (p) { return p.angle - p.boardAngle; }));

    var landmarks = getFourPointLandmarks().map(function (lm) {
      var expectedAngle = refAngle + lm.boardAngleDeg * Math.PI / 180;
      var bestIdx = -1, bestDiffDeg = Infinity;
      for (var i = 0; i < n; i++) {
        var prevI = (i - 1 + n) % n;
        if (!filled[prevI] || !filled[i] || filled[prevI] === filled[i]) continue;
        var imgAngle = Math.atan2(coords[i].y - ring.cy, coords[i].x - ring.cx);
        var diffRad = Math.atan2(Math.sin(imgAngle - expectedAngle), Math.cos(imgAngle - expectedAngle));
        var diffDeg = Math.abs(diffRad * 180 / Math.PI);
        if (diffDeg < bestDiffDeg) { bestDiffDeg = diffDeg; bestIdx = i; }
      }
      if (bestIdx === -1) {
        return { name: lm.name, boardAngleDeg: lm.boardAngleDeg, found: false, reason: 'No colour transition detected anywhere near the expected position.' };
      }
      if (bestDiffDeg > FOUR_POINT_SEARCH_WINDOW_DEG) {
        return { name: lm.name, boardAngleDeg: lm.boardAngleDeg, found: false, diffDeg: bestDiffDeg, reason: 'Nearest transition found was ' + bestDiffDeg.toFixed(1) + ' degrees from the expected position (search window is +/-' + FOUR_POINT_SEARCH_WINDOW_DEG + ').' };
      }
      return { name: lm.name, boardAngleDeg: lm.boardAngleDeg, found: true, diffDeg: bestDiffDeg, x: coords[bestIdx].x, y: coords[bestIdx].y };
    });

    for (var a = 0; a < landmarks.length; a++) {
      for (var b = a + 1; b < landmarks.length; b++) {
        if (!landmarks[a].found || !landmarks[b].found) continue;
        if (Math.hypot(landmarks[a].x - landmarks[b].x, landmarks[a].y - landmarks[b].y) < 8) {
          landmarks[a] = { name: landmarks[a].name, boardAngleDeg: landmarks[a].boardAngleDeg, found: false, reason: 'Resolved to the same physical point as ' + landmarks[b].name + '.' };
          landmarks[b] = { name: landmarks[b].name, boardAngleDeg: landmarks[b].boardAngleDeg, found: false, reason: 'Resolved to the same physical point as ' + landmarks[a].name + '.' };
        }
      }
    }

    return { referenceAngle: refAngle, landmarks: landmarks };
  }

  function detectBoardGeometry(canvas, detW, detH, videoW, videoH) {
    if (!OpenCVLoader.isReady()) return { confidence: 0, reason: 'OpenCV still loading' };
    var cv = window.cv;
    var tracked = [];
    function track(m) { tracked.push(m); return m; }
    try {
      var ctx = canvas.getContext('2d', { willReadFrequently: true });
      var imageData = ctx.getImageData(0, 0, detW, detH);
      var src = track(cv.matFromImageData(imageData));
      var rgb = track(new cv.Mat());
      cv.cvtColor(src, rgb, cv.COLOR_RGBA2RGB);
      var hsv = track(new cv.Mat());
      cv.cvtColor(rgb, hsv, cv.COLOR_RGB2HSV);

      var peaks = findAdaptiveHuePeaks(hsv);
      var ring = findRingEllipse(cv, hsv, peaks, detW, detH);
      if (!ring) return { confidence: 0, reason: 'No ring-coloured shape found' };

      var walk = walkRingForPoints(cv, hsv, ring, peaks, detW, detH);
      var pts20 = walk.points;
      var countScore = pts20.length === 20 ? 1 : Math.max(0, 1 - Math.abs(pts20.length - 20) / 4);
      var coverageScore = Math.max(0, Math.min(1, (walk.coverage - 0.5) / 0.4));
      var spacingScore = 0;
      if (pts20.length >= 3) {
        var angles = pts20.map(function (p) { return Math.atan2(p.y - ring.cy, p.x - ring.cx); }).sort(function (a, b) { return a - b; });
        var gaps = angles.map(function (a, i) { var next = angles[(i + 1) % angles.length]; var d = next - a; if (d < 0) d += Math.PI * 2; return d; });
        var meanGap = gaps.reduce(function (s, g) { return s + g; }, 0) / gaps.length;
        var gapVariance = gaps.reduce(function (s, g) { return s + Math.pow(g - meanGap, 2); }, 0) / gaps.length;
        spacingScore = Math.max(0, 1 - Math.sqrt(gapVariance) / (meanGap * 0.6));
      }
      var confidence = Math.max(0, Math.min(1, 0.40 * countScore + 0.30 * spacingScore + 0.30 * coverageScore));

      var fourPoint = detectFourPointLandmarks(cv, hsv, ring, peaks, detW, detH);

      var scaleX = videoW / detW, scaleY = videoH / detH;
      return {
        confidence: confidence,
        pointCount: pts20.length,
        center: { x: ring.cx * scaleX, y: ring.cy * scaleY },
        radiusX: ring.a * scaleX, radiusY: ring.b * scaleY,
        rotationRadians: ring.angleRad,
        ringPoints: pts20.map(function (p) { return { x: p.x * scaleX, y: p.y * scaleY }; }),
        // Diagnostic-only fields for the HUE DIAG overlay/debug rows below --
        // read by nothing in the calibration/scoring path, so they can never
        // change a score or a calibration result.
        huePeaks: { red: peaks.red, green: peaks.green },
        ringHueCoverage: walk.coverage,
        hueDiagPoints: walk.diag.coords.map(function (p, i) {
          return { x: p.x * scaleX, y: p.y * scaleY, label: walk.diag.rawLabels[i] };
        }),
        fourPointLandmarks: {
          referenceAngle: fourPoint.referenceAngle,
          landmarks: fourPoint.landmarks.map(function (l) {
            return l.found ? {
              name: l.name, boardAngleDeg: l.boardAngleDeg, found: true, diffDeg: l.diffDeg,
              x: l.x * scaleX, y: l.y * scaleY
            } : { name: l.name, boardAngleDeg: l.boardAngleDeg, found: false, diffDeg: l.diffDeg, reason: l.reason };
          })
        }
      };
    } catch (e) {
      return { confidence: 0, reason: 'Vision pipeline error: ' + e.message };
    } finally {
      tracked.forEach(function (m) { try { m.delete(); } catch (e2) {} });
    }
  }

  // =========================================================================
  // 4. SCORING -- ported verbatim from the local test bench / DartFeed's
  // own production calibration system. Unmodified: board coordinate
  // system, homography maths, segment order, ring thresholds.
  // =========================================================================
  var SCORE_SEGMENT_ORDER = [20, 1, 18, 4, 13, 6, 10, 15, 2, 17, 3, 19, 7, 16, 8, 11, 14, 9, 12, 5];
  // Regulation WDF dimensions are 99/107mm (treble) and 162/170mm (double)
  // on a 170mm scoring radius -- 8mm bands, razor-thin at camera-calibration
  // scale. Only the INNER edge of each ring is widened (by 3mm -- symmetric
  // widening on both edges was tried first and proved too generous), since
  // the only real evidence so far is a genuine treble landing just short of
  // the inner boundary (radius 0.576 vs the regulation 0.582 trebleInner,
  // ~1mm short) -- a dart being scored single instead of treble/double
  // because it's a hair inside the true ring. The outer edges stay at exact
  // regulation distance since there's no evidence of a problem there. Bull
  // is untouched too.
  var SCORE_RING_RATIO = { innerBull: 6.35 / 170, outerBull: 15.9 / 170, trebleInner: 96 / 170, trebleOuter: 107 / 170, doubleInner: 159 / 170, doubleOuter: 170 / 170 };

